<div {{ attributes }}>
    {% if this.error %}
        <div class="notification is-danger">{{ this.error }}</div>
    {% else %}
        {% set weeklyStats = this.weeklyStats %}
        <div class="is-flex is-align-items-center is-justify-content-flex-end mb-3">
            {% if this.notice %}
                <span class="has-text-success is-size-7 mr-3">{{ this.notice }}</span>
            {% endif %}
            <div class="buttons has-addons mb-0">
                <button
                    data-action="live#action"
                    data-live-action-param="refresh"
                    data-loading="action(refresh)|addClass(is-loading)"
                    class="button is-small mb-0"
                    title="Fetch the latest week from Strava"
                >
                    <span class="icon"><i class="fas fa-arrows-rotate"></i></span>
                    <span>Refresh</span>
                </button>
                <button
                    data-action="live#action"
                    data-live-action-param="reset"
                    data-loading="action(reset)|addClass(is-loading)"
                    class="button is-small mb-0"
                    title="Delete the stored stats and reload your whole history from Strava"
                >
                    <span class="icon"><i class="fas fa-clock-rotate-left"></i></span>
                    <span>Reset</span>
                </button>
            </div>
        </div>

        {% if weeklyStats is empty %}
            <div class="notification is-info is-light">
                No stored data yet. Click <b>Refresh</b> or <b>Reset</b> to load your activities from Strava.
            </div>
        {% endif %}
        <div class="table-container">
            <table class="table is-hoverable is-striped is-narrow-mobile has-text-centered is-fullwidth">
                <thead>
                <tr>
                    <th>Week</th>
                    <th>Mon</th>
                    <th>Tue</th>
                    <th>Wed</th>
                    <th>Thu</th>
                    <th>Fri</th>
                    <th>Sat</th>
                    <th>Sun</th>
                    <th>total</th>
                    <th>5 wk avg</th>
                    <th title="Change of the 5-week average from the week before">5 wk Δ</th>
                </tr>
                </thead>
                <tbody>
                {% for weeklyStat in weeklyStats %}
                    {# The menus of the last rows open upwards: below, the table box would cut them off. #}
                    {% set lastRows = loop.revindex <= 2 and loop.length > 2 %}
                    {% set row = loop.index %}
                    <tr>
                        <th>{{ weeklyStat.date }}</th>
                        {% for day, dailyStat in weeklyStat %}
                            <td>
                                {% if dailyStat.miles > 0 %}
                                    {# Tap (or hover, several activities): the activities of the day. On phones the icons go under the miles. #}
                                    {% set menuId = 'strava-day-' ~ row ~ '-' ~ day %}
                                    <div
                                        class="dropdown strava-day{{ dailyStat.activities|length > 1 ? ' strava-day--several' }}{{ loop.index > 4 ? ' is-right' }}{{ lastRows ? ' is-up' }}"
                                        data-controller="dropdown"
                                        data-action="click->dropdown#toggle click@window->dropdown#closeOutside keydown.esc@window->dropdown#close"
                                    >
                                        <button type="button" class="dropdown-trigger strava-day__trigger" aria-expanded="false" aria-controls="{{ menuId }}" data-dropdown-target="button">
                                            <span class="icon-text is-flex-wrap-nowrap">
                                                <span>{{ dailyStat.miles }}</span>
                                                {% for sport_icon in dailyStat.activitiesIcons %}
                                                    <span class="icon is-hidden-mobile">
                                                        <i class="fas fa-{{ sport_icon }}"></i>
                                                    </span>
                                                {% endfor %}
                                            </span>
                                            <span class="strava-day-icons is-hidden-tablet">
                                                {% for sport_icon in dailyStat.activitiesIcons %}
                                                    <i class="fas fa-{{ sport_icon }}"></i>
                                                {% endfor %}
                                            </span>
                                        </button>
                                        <div class="dropdown-menu" id="{{ menuId }}">
                                            <div class="dropdown-content has-text-left">
                                                {% for activity in dailyStat.activities %}
                                                    <div class="dropdown-item is-flex is-align-items-center is-flex-wrap-nowrap">
                                                        <span class="icon">
                                                            <i class="fas fa-{{ dailyStat.getSportIcon(activity.sport_type) ?? 'circle-question' }}"></i>
                                                        </span>
                                                        <span class="ml-1">{{ (activity.distance/1609.34)|round(1) }} mi</span>
                                                        <span class="ml-2 has-text-grey is-size-7">{{ activity.sport_type }}</span>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                            </td>
                        {% endfor %}
                        <td><b>{{ weeklyStat.totalMiles }}<span class="is-hidden-mobile">{{ ' mi' }}</span></b></td>
                        <td>
                            {% if not loop.first and date('D') != 'Sun' %}<b>{% endif %}
                                {{ (weeklyStat.fiveWeekAverage/1609.34)|round(1) }}<span class="is-hidden-mobile">{{ ' mi' }}</span>
                            {% if not loop.first and date('D') != 'Sun' %}</b>{% endif %}
                        </td>
                        <td>
                            {% if not loop.last %}
                                {{ ((weeklyStats[loop.index0].fiveWeekAverage - weeklyStats[loop.index].fiveWeekAverage)/1609.34)|round(1) }}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="has-text-centered py-4">
            {% if weeklyStats is not empty and this.missingWeeks %}
                <p class="is-size-7 has-text-grey mb-2">
                    Showing all stored weeks. Click <b>Reset</b> to reload your whole history from Strava.
                </p>
            {% endif %}
            <button
                data-action="live#action"
                data-live-action-param="loadMore"
                class="button"
            >
                Load more
            </button>
        </div>
    {% endif %}
</div>
