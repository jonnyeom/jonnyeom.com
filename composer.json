{
    "name": "jonnyeom/jonnyeom.com",
    "license": "proprietary",
    "type": "project",
    "description": "Jonnyeom Personal Site",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "replace": {
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "require": {
        "php": "^8.5",
        "ext-intl": "*",
        "api-platform/core": "^4.4",
        "basvandorst/stravaphp": "^2.0.0",
        "doctrine/dbal": "^4.4",
        "doctrine/doctrine-bundle": "^3.4",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6.9",
        "league/commonmark": "^2.8.2",
        "nelmio/cors-bundle": "^2.6.1",
        "pentatrion/vite-bundle": "^8.2.4",
        "phpdocumentor/reflection-docblock": "^5.6.7",
        "rami/seo-bundle": "^1.2",
        "spatie/commonmark-highlighter": "^3.0.0",
        "spatie/yaml-front-matter": "^2.1.1",
        "symfony/apache-pack": "^1.0.1",
        "symfony/asset": "^8.1",
        "symfony/console": "^8.1.11",
        "symfony/dotenv": "^8.1.6",
        "symfony/expression-language": "^8.1.9",
        "symfony/flex": "^2.11.0",
        "symfony/form": "^8.1.11",
        "symfony/framework-bundle": "^8.1.11",
        "symfony/intl": "^8.1.10",
        "symfony/monolog-bundle": "^4.1",
        "symfony/process": "^8.1.10",
        "symfony/property-access": "^8.1.11",
        "symfony/property-info": "^8.1.11",
        "symfony/runtime": "^8.1.11",
        "symfony/security-bundle": "^8.1.11",
        "symfony/serializer": "^8.1.11",
        "symfony/stimulus-bundle": "^2.36.0",
        "symfony/translation": "^8.1.11",
        "symfony/twig-bundle": "^8.1.9",
        "symfony/type-info": "^8.1.11",
        "symfony/ux-chartjs": "^2.36",
        "symfony/ux-live-component": "^3.0",
        "symfony/ux-react": "^2.36.0",
        "symfony/validator": "^8.1.11",
        "symfony/web-link": "^8.1",
        "symfony/yaml": "^8.1.11"
    },
    "require-dev": {
        "doctrine/coding-standard": "^14.0.0",
        "phpstan/phpdoc-parser": "^2.3.3",
        "phpstan/phpstan": "^2.2.9",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpstan/phpstan-symfony": "^2.0.20",
        "phpunit/phpunit": "^11.5.56",
        "rector/rector": "^2.4.6",
        "squizlabs/php_codesniffer": "^4.0.4",
        "symfony/browser-kit": "^8.1.11",
        "symfony/css-selector": "^8.1.10",
        "symfony/debug-bundle": "^8.1",
        "symfony/maker-bundle": "^1.67.0",
        "symfony/phpunit-bridge": "^8.1.10",
        "symfony/stopwatch": "^8.1",
        "symfony/web-profiler-bundle": "^8.1.11"
    },
    "config": {
"optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install --symlink --relative %PUBLIC_DIR%": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "8.1.*",
            "docker": true
        }
    }
}
