{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "enabledManagers": [
        "composer",
        "npm"
    ],
    "extends": [
        "config:best-practices",
        "default:automergePatch",
        "default:separateMultipleMajorReleases",
        "schedule:weekends",
        "schedule:automergeEarlyMondays"
    ],
    "dependencyDashboard": {
        "enabled": true
    },
    "timezone": "America/New_York",
    "rangeStrategy": "bump",
    "automergeType": "branch",
    "minimumReleaseAge": "7 days",
    "packageRules": [
        {
            "description": "Don't bump the php constraint in composer.json; we manage that ourselves",
            "matchPackageNames": [
                "php"
            ],
            "enabled": false
        },
        {
            "matchPackageNames": [
                "league/commonmark",
                "leogout/seo-bundle",
                "nelmio/cors-bundle",
                "/spatie/"
            ],
            "groupName": "application packages",
            "groupSlug": "application"
        },
        {
            "groupName": "api-platform packages",
            "groupSlug": "api-platform",
            "matchPackageNames": [
                "/api-platform/"
            ]
        },
        {
            "matchPackageNames": [
                "dealerdirect/phpcodesniffer-composer-installer",
                "doctrine/coding-standard",
                "rector/rector",
                "squizlabs/php_codesniffer",
                "/^phpstan/phpstan$/",
                "/phpstan-/",
                "/phpstan/phpdoc-parser/",
                "/phpunit/phpunit/"
            ],
            "groupName": "Development packages",
            "groupSlug": "dev"
        },
        {
            "groupName": "twig packages",
            "groupSlug": "twig",
            "matchPackageNames": [
                "twig/{/,}**"
            ]
        },
        {
            "groupName": "symfony packages",
            "groupSlug": "symfony",
            "separateMinorPatch": true,
            "matchPackageNames": [
                "symfony/{/,}**"
            ]
        },
        {
            "description": "Don't upgrade symfony past 8.1 until we do it ourselves, with extra.symfony.require in composer.json",
            "allowedVersions": "<8.2.0",
            "matchPackageNames": [
                "symfony/{/,}**"
            ]
        }
    ]
}
